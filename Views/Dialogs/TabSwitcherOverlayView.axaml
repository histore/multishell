<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MultiShell.ViewModels"
             xmlns:models="using:MultiShell.Models"
             xmlns:dialogs="using:MultiShell.Views.Dialogs"
             x:Class="MultiShell.Views.Dialogs.TabSwitcherOverlayView"
             x:DataType="vm:MainViewModel">

    <!-- Unified Tab Switcher HUD Overlay (Ctrl+Tab & Tab Bar Button) (REQ-TAB-019, REQ-TAB-027) -->
    <Grid x:Name="TabSwitcherOverlayGrid"
          Background="#66000000"
          IsVisible="{Binding IsTabSwitcherOpen}"
          ZIndex="45"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Border Width="560"
                MaxHeight="440"
                Background="{DynamicResource AppSurfaceModal}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1"
                CornerRadius="8"
                BoxShadow="0 8 32 0 #88000000"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="16">
            <Grid RowDefinitions="Auto, *, Auto">
                <!-- Switcher Header -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,12">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="📑" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Loc[Tab_Switcher_Title]}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="{DynamicResource AppAccent}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding TabSwitcherCountText}"
                               FontSize="11"
                               Foreground="{DynamicResource AppTextMuted}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                    <Button Grid.Column="2"
                            Content="✕"
                            Classes="tabCloseBtn"
                            Command="{Binding CancelTabSwitcherCommand}"
                            Width="22" Height="22"
                            FontSize="11"
                            Padding="0" />
                </Grid>

                <!-- Switcher Tab List -->
                <Border Grid.Row="1" Classes="modalSection" Margin="0,0,0,10" Padding="4">
                    <ListBox x:Name="TabSwitcherListBox"
                             Classes="tabSwitcherListBox"
                             ItemsSource="{Binding Tabs}"
                             SelectedIndex="{Binding TabSwitcherSelectedIndex, Mode=TwoWay}"
                             MaxHeight="280">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TerminalTabViewModel">
                                <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto"
                                      Background="Transparent">
                                    <!-- Optional Tab Accent Color Indicator (REQ-TAB-020 / REQ-TAB-027) -->
                                    <Border Grid.Column="0"
                                            Width="3"
                                            CornerRadius="1.5"
                                            Margin="0,2,8,2"
                                            Background="{Binding TabColorBrush}"
                                            IsVisible="{Binding HasTabColor}"
                                            VerticalAlignment="Stretch" />

                                    <!-- Shell Badge Icon (REQ-TAB-027) -->
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource AppSurfaceSubtle}"
                                            BorderBrush="{DynamicResource AppBorder}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,3"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ShellIconTag}"
                                                   FontFamily="Consolas, Cascadia Code, monospace"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AppAccent}" />
                                    </Border>

                                    <!-- Tab Title, Status Badge & Directory (REQ-TAB-027) -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <!-- Process Status Indicator Badge (REQ-TAB-027 / REQ-TERM-012) -->
                                            <Border IsVisible="{Binding HasProcessStatus}"
                                                    Background="{DynamicResource AppSurfaceSubtle}"
                                                    BorderBrush="{Binding ExecutionStatusForeground}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="3,1"
                                                    VerticalAlignment="Center"
                                                    Opacity="{Binding OutputActivityOpacity}"
                                                    ToolTip.Tip="{Binding ExecutionStatusTooltip}">
                                                <Border.Transitions>
                                                    <Transitions>
                                                        <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut" />
                                                    </Transitions>
                                                </Border.Transitions>
                                                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ExecutionStatusGlyph}"
                                                               FontFamily="Consolas, Cascadia Code, monospace"
                                                               FontSize="8"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding ExecutionStatusForeground}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding LastExitCode}"
                                                               IsVisible="{Binding HasProcessError}"
                                                               FontFamily="Consolas, Cascadia Code, monospace"
                                                               FontSize="8"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding ExecutionStatusForeground}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource AppTextPrimary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="280" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <!-- Dynamic Path Color Stripes (REQ-TAB-025 / REQ-TAB-027) -->
                                            <ItemsControl ItemsSource="{Binding PathColorStripes}"
                                                          IsVisible="{Binding HasPathColorStripes}"
                                                          VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="1" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:PathColorStripe">
                                                        <Border Width="{Binding Width}"
                                                                Height="3"
                                                                Background="{Binding HexColor}"
                                                                CornerRadius="0.5" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{Binding WorkingDirectory}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource AppTextMuted}"
                                                       TextTrimming="PrefixCharacterEllipsis"
                                                       MaxWidth="320" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Active Badge Indicator -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,4,0">
                                        <TextBlock Text="●"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource AppSuccess}"
                                                   IsVisible="{Binding IsSelected}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Close Tab Button (REQ-TAB-023) -->
                                    <Button Grid.Column="4"
                                            Classes="tabSwitcherCloseBtn"
                                            Command="{Binding $parent[dialogs:TabSwitcherOverlayView].((vm:MainViewModel)DataContext).CloseTabFromSwitcherCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding $parent[dialogs:TabSwitcherOverlayView].((vm:MainViewModel)DataContext).Loc[Btn_Tab_Close_Tooltip]}"
                                            Margin="6,0,2,0">
                                        <TextBlock Text="✕"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Switcher Footer (Shortcuts / Navigation Hint) -->
                <TextBlock Grid.Row="2"
                           Text="{Binding TabSwitcherHintText}"
                           FontSize="10"
                           Foreground="{DynamicResource AppTextMuted}"
                           HorizontalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
