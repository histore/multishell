<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MultiShell.ViewModels"
             x:Class="MultiShell.Views.Dialogs.HistoryDrawerView"
             x:DataType="vm:MainViewModel">

    <!-- Centered History Overlay Panel with Backdrop (REQ-TAB-012) -->
    <Grid x:Name="HistoryDrawerGrid"
          Background="#55000000"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          IsVisible="False"
          ZIndex="45">
        <!-- Centered Overlay Container with prominent margin to outer boundary -->
        <Border Width="700"
                MaxWidth="800"
                MaxHeight="540"
                Margin="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource AppSurfaceModal}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1"
                CornerRadius="8"
                BoxShadow="0 8 32 0 #88000000">
            <Grid RowDefinitions="Auto, *">
                <!-- Drawer Header -->
                <Border Grid.Row="0" Background="{DynamicResource AppHeaderBackground}" BorderBrush="{DynamicResource AppBorderSubtle}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="14,10">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Loc[Drawer_Title]}" FontFamily="Consolas, Cascadia Code, monospace" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center" />
                            <TextBlock Text="[ ▲/▼ Navigate  |  Enter Execute  |  Esc Close ]" FontFamily="Consolas, monospace" FontSize="10" Foreground="{DynamicResource AppTextMuted}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="✕"
                                x:Name="CloseHistoryButton"
                                Background="Transparent"
                                Foreground="{DynamicResource AppTextMuted}"
                                Padding="6,2"
                                FontSize="11" />
                    </Grid>
                </Border>

                <!-- Drawer Content: TabControl for Commands and Directories -->
                <TabControl x:Name="HistoryTabControl" Grid.Row="1" Classes="historyTabs" Margin="8,4,8,8">
                    <!-- Tab 1: Commands -->
                    <TabItem Header="{Binding Loc[Drawer_Tab_Commands]}">
                        <Grid RowDefinitions="Auto, *">
                            <!-- Search Filter Box -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource AppSurfaceSubtle}"
                                    BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,6,0,6"
                                    Padding="4">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Margin="6,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMuted}" />
                                    <TextBox Grid.Column="1"
                                             x:Name="CommandHistorySearchBox"
                                             Text="{Binding SelectedTab.CommandFilterQuery, Mode=TwoWay}"
                                             PlaceholderText="{Binding Loc[Drawer_Search_Commands_Placeholder]}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="12"
                                             VerticalAlignment="Center" />
                                    <Button Grid.Column="2"
                                            x:Name="ClearCommandFilterBtn"
                                            Content="✕"
                                            Background="Transparent"
                                            Foreground="{DynamicResource AppTextMuted}"
                                            FontSize="10"
                                            Padding="4,2"
                                            IsVisible="{Binding !!SelectedTab.CommandFilterQuery.Length}" />
                                </Grid>
                            </Border>

                            <!-- Command List -->
                            <Border Grid.Row="1" Background="{DynamicResource AppSurfaceSubtle}" CornerRadius="6" Padding="4" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
                                <Grid>
                                    <ListBox x:Name="CommandHistoryListBox"
                                             Classes="historyListBox"
                                             SelectionMode="Single"
                                             Focusable="True"
                                             ItemsSource="{Binding SelectedTab.FilteredCommandHistory}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid ColumnDefinitions="Auto, *">
                                                    <TextBlock Grid.Column="0"
                                                               Text="> "
                                                               FontFamily="Consolas, Cascadia Code, monospace"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource AppSuccess}"
                                                               Margin="0,0,4,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding}"
                                                               FontFamily="Consolas, Cascadia Code, monospace"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource AppTextSecondary}"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{Binding Loc[Drawer_Empty_Commands]}"
                                               Foreground="{DynamicResource AppTextMuted}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !SelectedTab.FilteredCommandHistory.Count}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Tab 2: Directories -->
                    <TabItem Header="{Binding Loc[Drawer_Tab_Directories]}">
                        <Grid RowDefinitions="Auto, *">
                            <!-- Search Filter Box -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource AppSurfaceSubtle}"
                                    BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,6,0,6"
                                    Padding="4">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Margin="6,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMuted}" />
                                    <TextBox Grid.Column="1"
                                             x:Name="DirectoryHistorySearchBox"
                                             Text="{Binding SelectedTab.DirectoryFilterQuery, Mode=TwoWay}"
                                             PlaceholderText="{Binding Loc[Drawer_Search_Directories_Placeholder]}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="12"
                                             VerticalAlignment="Center" />
                                    <Button Grid.Column="2"
                                            x:Name="ClearDirectoryFilterBtn"
                                            Content="✕"
                                            Background="Transparent"
                                            Foreground="{DynamicResource AppTextMuted}"
                                            FontSize="10"
                                            Padding="4,2"
                                            IsVisible="{Binding !!SelectedTab.DirectoryFilterQuery.Length}" />
                                </Grid>
                            </Border>

                            <!-- Directory List -->
                            <Border Grid.Row="1" Background="{DynamicResource AppSurfaceSubtle}" CornerRadius="6" Padding="4" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
                                <Grid>
                                    <ListBox x:Name="DirectoryHistoryListBox"
                                             Classes="historyListBox"
                                             SelectionMode="Single"
                                             Focusable="True"
                                             ItemsSource="{Binding SelectedTab.FilteredDirectoryHistory}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid ColumnDefinitions="Auto, *">
                                                    <TextBlock Grid.Column="0"
                                                               Text="/ "
                                                               FontFamily="Consolas, Cascadia Code, monospace"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource AppAccent}"
                                                               Margin="0,0,4,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding}"
                                                               FontFamily="Consolas, Cascadia Code, monospace"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource AppTextSecondary}"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{Binding Loc[Drawer_Empty_Directories]}"
                                               Foreground="{DynamicResource AppTextMuted}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !SelectedTab.FilteredDirectoryHistory.Count}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Tab 3: Global (All Commands & Directories) -->
                    <TabItem Header="{Binding Loc[Drawer_Tab_Global]}">
                        <Grid RowDefinitions="Auto, *">
                            <!-- Search Filter Box -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource AppSurfaceSubtle}"
                                    BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,6,0,6"
                                    Padding="4">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Margin="6,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMuted}" />
                                    <TextBox Grid.Column="1"
                                             x:Name="GlobalHistorySearchBox"
                                             Text="{Binding SelectedTab.GlobalFilterQuery, Mode=TwoWay}"
                                             PlaceholderText="{Binding Loc[Drawer_Search_Global_Placeholder]}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="12"
                                             VerticalAlignment="Center" />
                                    <Button Grid.Column="2"
                                            x:Name="ClearGlobalFilterBtn"
                                            Content="✕"
                                            Background="Transparent"
                                            Foreground="{DynamicResource AppTextMuted}"
                                            FontSize="10"
                                            Padding="4,2"
                                            IsVisible="{Binding !!SelectedTab.GlobalFilterQuery.Length}" />
                                </Grid>
                            </Border>

                            <!-- Global List -->
                            <Border Grid.Row="1" Background="{DynamicResource AppSurfaceSubtle}" CornerRadius="6" Padding="4" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
                                <Grid>
                                    <ListBox x:Name="GlobalHistoryListBox"
                                             Classes="historyListBox"
                                             SelectionMode="Single"
                                             Focusable="True"
                                             ItemsSource="{Binding SelectedTab.FilteredGlobalHistory}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GlobalHistoryItem">
                                                <Grid ColumnDefinitions="Auto, Auto, *">
                                                    <Border Grid.Column="0"
                                                            CornerRadius="3"
                                                            Padding="3,1"
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource AppSurfaceBackground}"
                                                            BorderBrush="{DynamicResource AppBorder}"
                                                            BorderThickness="1">
                                                        <TextBlock Text="{Binding BadgeText}"
                                                                   FontFamily="Consolas, Cascadia Code, monospace"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource AppTextMuted}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding IconText}"
                                                               FontFamily="Consolas, Cascadia Code, monospace"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource AppAccent}"
                                                               Margin="0,0,4,0" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Text}"
                                                               FontFamily="Consolas, Cascadia Code, monospace"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource AppTextSecondary}"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{Binding Loc[Drawer_Empty_Global]}"
                                               Foreground="{DynamicResource AppTextMuted}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !SelectedTab.FilteredGlobalHistory.Count}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
