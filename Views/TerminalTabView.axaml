<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MultiShell.ViewModels"
             xmlns:views="using:MultiShell.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="MultiShell.Views.TerminalTabView"
             x:DataType="vm:TerminalTabViewModel"
             Focusable="True"
             UseLayoutRounding="True"
             Background="{Binding TerminalBackgroundBrush}">

    <views:SplitPaneContainerControl x:Name="PaneContainer"
                                     RootNode="{Binding DisplayRootNode}"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch" />
</UserControl>
