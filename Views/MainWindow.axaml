<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MultiShell.ViewModels"
        xmlns:views="using:MultiShell.Views"
        xmlns:dialogs="using:MultiShell.Views.Dialogs"
        xmlns:controls="using:MultiShell.Views.Controls"
        xmlns:services="using:MultiShell.Services"
        xmlns:models="using:MultiShell.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen"
        x:Class="MultiShell.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/multishell.ico"
        Background="{DynamicResource AppWindowBackground}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Command="{Binding AddNewTabCommand}" Gesture="Ctrl+Shift+T" />
        <KeyBinding Command="{Binding DuplicateTabCommand}" Gesture="Ctrl+Shift+D" />
        <KeyBinding Command="{Binding UndockTabCommand}" Gesture="Ctrl+Shift+U" />
        <KeyBinding Command="{Binding CloseActivePaneOrTabCommand}" Gesture="Ctrl+Shift+W" />
        <KeyBinding Command="{Binding CloseActivePaneOrTabCommand}" Gesture="Ctrl+Shift+F4" />
        <!-- Split Panes Keybindings (REQ-UI-006) -->
        <KeyBinding Command="{Binding SplitActiveTabRightCommand}" Gesture="Alt+Shift+Right" />
        <KeyBinding Command="{Binding SplitActiveTabRightCommand}" Gesture="Alt+Shift+V" />
        <KeyBinding Command="{Binding SplitActiveTabDownCommand}" Gesture="Alt+Shift+Down" />
        <KeyBinding Command="{Binding SplitActiveTabDownCommand}" Gesture="Alt+Shift+H" />
        <KeyBinding Command="{Binding ToggleZoomActiveTabCommand}" Gesture="Alt+Shift+Z" />
        <KeyBinding Command="{Binding FocusNextPaneActiveTabCommand}" Gesture="F6" />
        <KeyBinding Command="{Binding FocusPreviousPaneActiveTabCommand}" Gesture="Shift+F6" />
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Top Toolbar Header Bar -->
        <LayoutTransformControl Grid.Row="0">
            <LayoutTransformControl.LayoutTransform>
                <ScaleTransform ScaleX="{Binding AppFontScale}" ScaleY="{Binding AppFontScale}" />
            </LayoutTransformControl.LayoutTransform>
            <Border Background="{DynamicResource AppHeaderBackground}" BorderBrush="{DynamicResource AppBorderSubtle}" BorderThickness="0,0,0,1" Padding="6,4,6,0">
            <Grid ColumnDefinitions="*, Auto">
                <!-- Tab Bar with Overflow Navigation -->
                <Grid x:Name="TabBarContainer" Grid.Column="0" ColumnDefinitions="Auto, *, Auto, Auto, Auto" Margin="0,0,6,0" Background="Transparent" DragDrop.AllowDrop="True">
                    <!-- Left Scroll Arrow Button -->
                    <Button x:Name="TabScrollLeftBtn"
                            Grid.Column="0"
                            Classes="tabScrollBtn"
                            Content="‹"
                            ToolTip.Tip="{Binding Loc[Btn_Tab_Scroll_Left]}"
                            IsVisible="False"
                            VerticalAlignment="Bottom"
                            Margin="0,0,2,0"
                            DragDrop.AllowDrop="True" />

                    <!-- Scrollable Tabs Area with Edge Gradient Overlays -->
                    <Grid Grid.Column="1">
                        <ScrollViewer x:Name="TabsScrollViewer"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      Background="Transparent">
                            <!-- Tabs List -->
                            <ItemsControl x:Name="TabsItemsControl" ItemsSource="{Binding Tabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Bottom" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TerminalTabViewModel">
                                        <Button Classes="tabBtn"
                                                Classes.active="{Binding IsSelected}"
                                                Focusable="False"
                                                ToolTip.Tip="{Binding TabTooltip}"
                                                ToolTip.ShowDelay="150"
                                                Command="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).SelectTabCommand}"
                                                CommandParameter="{Binding}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Menu_Tab_Rename]}"
                                                              InputGesture="Ctrl+Shift+F2"
                                                              Command="{Binding StartRenamingCommand}" />
                                                    <MenuItem Header="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Menu_Tab_ResetName]}"
                                                              IsEnabled="{Binding HasCustomTitle}"
                                                              Command="{Binding ResetCustomTitleCommand}" />
                                                    <MenuItem Header="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Menu_Tab_Color]}">
                                                        <MenuItem Header="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Color_Default]}"
                                                                  Command="{Binding SetTabColorCommand}"
                                                                  CommandParameter="{x:Null}" />
                                                        <Separator />
                                                        <MenuItem Header="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Color_Red]}"
                                                                  Command="{Binding SetTabColorCommand}"
                                                                  CommandParameter="#F7768E">
                                                            <MenuItem.Icon>
                                                                <Border Width="12" Height="12" CornerRadius="6" Background="#F7768E" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Color_Orange]}"
                                                                  Command="{Binding SetTabColorCommand}"
                                                                  CommandParameter="#FF9E64">
                                                            <MenuItem.Icon>
                                                                <Border Width="12" Height="12" CornerRadius="6" Background="#FF9E64" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Color_Yellow]}"
                                                                  Command="{Binding SetTabColorCommand}"
                                                                  CommandParameter="#E0AF68">
                                                            <MenuItem.Icon>
                                                                <Border Width="12" Height="12" CornerRadius="6" Background="#E0AF68" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Color_Green]}"
                                                                  Command="{Binding SetTabColorCommand}"
                                                                  CommandParameter="#9ECE6A">
                                                            <MenuItem.Icon>
                                                                <Border Width="12" Height="12" CornerRadius="6" Background="#9ECE6A" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Color_Cyan]}"
                                                                  Command="{Binding SetTabColorCommand}"
                                                                  CommandParameter="#7DCFFF">
                                                            <MenuItem.Icon>
                                                                <Border Width="12" Height="12" CornerRadius="6" Background="#7DCFFF" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Color_Blue]}"
                                                                  Command="{Binding SetTabColorCommand}"
                                                                  CommandParameter="#7AA2F7">
                                                            <MenuItem.Icon>
                                                                <Border Width="12" Height="12" CornerRadius="6" Background="#7AA2F7" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Color_Purple]}"
                                                                  Command="{Binding SetTabColorCommand}"
                                                                  CommandParameter="#BB9AF7">
                                                            <MenuItem.Icon>
                                                                <Border Width="12" Height="12" CornerRadius="6" Background="#BB9AF7" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Color_Pink]}"
                                                                  Command="{Binding SetTabColorCommand}"
                                                                  CommandParameter="#F43F5E">
                                                            <MenuItem.Icon>
                                                                <Border Width="12" Height="12" CornerRadius="6" Background="#F43F5E" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Menu_Tab_Duplicate]}"
                                                              InputGesture="Ctrl+Shift+D"
                                                              Command="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).DuplicateTabCommand}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Menu_Tab_OpenInExplorer]}"
                                                              InputGesture="Ctrl+Shift+E"
                                                              Command="{Binding OpenInFileBrowserCommand}" />
                                                    <Separator />
                                                    <MenuItem Header="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Menu_Tab_Undock]}"
                                                              InputGesture="Ctrl+Shift+U"
                                                              Command="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).UndockTabCommand}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Menu_Tab_DockBack]}"
                                                              Command="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).DockBackTabCommand}"
                                                              CommandParameter="{Binding}"
                                                              IsVisible="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).CanDockBack}" />
                                                    <Separator />
                                                    <MenuItem Header="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Menu_Pane_SplitRight]}"
                                                              InputGesture="Alt+Shift+Right"
                                                              Command="{Binding SplitRightCommand}" />
                                                    <MenuItem Header="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Menu_Pane_SplitDown]}"
                                                              InputGesture="Alt+Shift+Down"
                                                              Command="{Binding SplitDownCommand}" />
                                                    <MenuItem Header="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Menu_Pane_ToggleZoom]}"
                                                              InputGesture="Alt+Shift+Z"
                                                              Command="{Binding ToggleZoomCommand}"
                                                              IsEnabled="{Binding HasMultiplePanes}" />
                                                    <Separator />
                                                    <MenuItem Header="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Menu_Tab_Close]}"
                                                              InputGesture="Ctrl+Shift+W"
                                                              Command="{Binding RequestCloseCommand}" />
                                                    <MenuItem Header="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Menu_Tab_CloseOthers]}"
                                                              Command="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).CloseOtherTabsCommand}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Menu_Tab_CloseRight]}"
                                                              Command="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).CloseTabsToRightCommand}"
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid>
                                                <!-- Top Dynamic Path Color Stripes (REQ-TAB-025) -->
                                                <Grid VerticalAlignment="Top"
                                                      HorizontalAlignment="Left"
                                                      Margin="0,0,0,0"
                                                      Height="3"
                                                      MaxWidth="{Binding #TabContentPanel.Bounds.Width}"
                                                      IsHitTestVisible="False"
                                                      IsVisible="{Binding HasPathColorStripes}">
                                                    <Viewbox Stretch="Fill"
                                                             StretchDirection="DownOnly"
                                                             Height="3"
                                                             HorizontalAlignment="Left">
                                                        <ItemsControl ItemsSource="{Binding PathColorStripes}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="1" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                 <DataTemplate x:DataType="models:PathColorStripe">
                                                                     <Border Width="{Binding Width}"
                                                                             Height="{Binding Height}"
                                                                             Background="{Binding HexColor}"
                                                                             CornerRadius="0.5" />
                                                                 </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Viewbox>
                                                </Grid>

                                                <StackPanel x:Name="TabContentPanel"
                                                            Orientation="Horizontal"
                                                            Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <Border Background="{DynamicResource AppSurfaceSubtle}"
                                                            CornerRadius="3"
                                                            Padding="3,1"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ShellIconTag}"
                                                                   FontFamily="Consolas, Cascadia Code, monospace"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource AppAccent}"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <!-- Process Status Indicator Badge (REQ-TERM-012) -->
                                                    <Border IsVisible="{Binding HasProcessStatus}"
                                                            Background="{DynamicResource AppSurfaceSubtle}"
                                                            BorderBrush="{Binding ExecutionStatusForeground}"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="3,1"
                                                            VerticalAlignment="Center"
                                                            Opacity="{Binding OutputActivityOpacity}"
                                                            ToolTip.Tip="{Binding ExecutionStatusTooltip}">
                                                        <Border.Transitions>
                                                            <Transitions>
                                                                <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut" />
                                                            </Transitions>
                                                        </Border.Transitions>
                                                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ExecutionStatusGlyph}"
                                                                       FontFamily="Consolas, Cascadia Code, monospace"
                                                                       FontSize="8"
                                                                       FontWeight="Bold"
                                                                       Foreground="{Binding ExecutionStatusForeground}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding LastExitCode}"
                                                                       IsVisible="{Binding HasProcessError}"
                                                                       FontFamily="Consolas, Cascadia Code, monospace"
                                                                       FontSize="8"
                                                                       FontWeight="Bold"
                                                                       Foreground="{Binding ExecutionStatusForeground}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="{Binding DisplayTitle}"
                                                               VerticalAlignment="Center"
                                                               MaxWidth="180"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsVisible="{Binding !IsRenaming}" />
                                                    <TextBox x:Name="TabRenameBox"
                                                             Classes="tabRenameBox"
                                                             Text="{Binding RenameBuffer, Mode=TwoWay}"
                                                             MaxWidth="180"
                                                             IsVisible="{Binding IsRenaming}" />
                                                    <Button Classes="tabCloseBtn"
                                                            Focusable="False"
                                                            Content="×"
                                                            Command="{Binding RequestCloseCommand}"
                                                            ToolTip.Tip="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Btn_Tab_Close_Tooltip]}" />
                                                </StackPanel>
                                                <!-- Bottom Tab Color Accent Line -->
                                                <Border Height="2.5"
                                                        VerticalAlignment="Bottom"
                                                        HorizontalAlignment="Stretch"
                                                        Margin="-10,0,-10,-1"
                                                        CornerRadius="0,0,2,2"
                                                        Background="{Binding TabColorBrush}"
                                                        IsVisible="{Binding HasTabColor}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Left Edge Gradient Indicator -->
                        <Border x:Name="LeftEdgeFade"
                                HorizontalAlignment="Left"
                                Width="20"
                                IsHitTestVisible="False"
                                IsVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                    <GradientStop Offset="0.0" Color="#B30C0D12" />
                                    <GradientStop Offset="1.0" Color="#000C0D12" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Right Edge Gradient Indicator -->
                        <Border x:Name="RightEdgeFade"
                                HorizontalAlignment="Right"
                                Width="20"
                                IsHitTestVisible="False"
                                IsVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                    <GradientStop Offset="0.0" Color="#000C0D12" />
                                    <GradientStop Offset="1.0" Color="#B30C0D12" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <!-- Right Scroll Arrow Button (placed immediately left of Add Tab button) -->
                    <Button x:Name="TabScrollRightBtn"
                            Grid.Column="2"
                            Classes="tabScrollBtn"
                            Content="›"
                            ToolTip.Tip="{Binding Loc[Btn_Tab_Scroll_Right]}"
                            IsVisible="False"
                            VerticalAlignment="Bottom"
                            Margin="2,0,2,0"
                            DragDrop.AllowDrop="True" />

                    <!-- Docked Add Tab (+) and Shell Selector (▾) Buttons -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="0" VerticalAlignment="Bottom">
                        <Button Classes="addTabBtn"
                                Content="+"
                                ToolTip.Tip="{Binding NewTabTooltip}"
                                Command="{Binding AddNewTabCommand}"
                                VerticalAlignment="Bottom" />
                        <Button Classes="tabShellDropdownBtn"
                                Content="▾"
                                ToolTip.Tip="{Binding Loc[Btn_Select_Shell_Tooltip]}"
                                VerticalAlignment="Bottom">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <Border Background="{DynamicResource AppSurfaceModal}"
                                            BorderBrush="{DynamicResource AppBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="4"
                                            MinWidth="240"
                                            MaxWidth="320">
                                        <StackPanel Spacing="4">
                                            <!-- Profiles List -->
                                            <ItemsControl ItemsSource="{Binding Profiles}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:TerminalProfileItemViewModel">
                                                        <Button Classes="tabMenuItemBtn"
                                                                Command="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).AddNewTabWithProfileCommand}"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding IsAvailable}"
                                                                HorizontalAlignment="Stretch">
                                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                                <Border Background="{DynamicResource AppSurfaceSubtle}"
                                                                        CornerRadius="3"
                                                                        Padding="4,2"
                                                                        Margin="0,0,8,0"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding IconTag}"
                                                                               FontFamily="Consolas, Cascadia Code, monospace"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               Foreground="{DynamicResource AppAccent}" />
                                                                </Border>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Name}"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="12" />
                                                                <TextBlock Grid.Column="2"
                                                                           Text="✓"
                                                                           IsVisible="{Binding IsAvailable}"
                                                                           Foreground="{DynamicResource AppSuccess}"
                                                                           FontSize="11"
                                                                           Margin="6,0,0,0"
                                                                           VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Recently Closed Tabs Section (REQ-TAB-021) -->
                                            <StackPanel IsVisible="{Binding HasClosedTabs}" Spacing="2" Margin="0,4,0,0">
                                                <Border Height="1" Background="{DynamicResource AppBorderSubtle}" Margin="0,2,0,4" />
                                                <Grid ColumnDefinitions="*, Auto" Margin="6,2,6,4">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Loc[ClosedTabs_Title]}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource AppTextMuted}"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="1"
                                                            Classes="tabMenuItemBtn"
                                                            Content="{Binding Loc[ClosedTabs_ClearAll]}"
                                                            Command="{Binding ClearClosedTabsCommand}"
                                                            FontSize="9"
                                                            Padding="4,1"
                                                            Foreground="{DynamicResource AppTextDimmed}"
                                                            VerticalAlignment="Center" />
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding ClosedTabs}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ClosedTabItemViewModel">
                                                            <Grid ColumnDefinitions="*, Auto" Margin="0,1">
                                                                <Button Grid.Column="0"
                                                                        Classes="tabMenuItemBtn"
                                                                        Command="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).RestoreClosedTabCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip.Tip="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[ClosedTabs_RestoreTooltip]}"
                                                                        HorizontalAlignment="Stretch">
                                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                                        <Border Background="{DynamicResource AppSurfaceSubtle}"
                                                                                CornerRadius="3"
                                                                                Padding="4,2"
                                                                                Margin="0,0,8,0"
                                                                                VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding ShellIconTag}"
                                                                                       FontFamily="Consolas, Cascadia Code, monospace"
                                                                                       FontSize="9"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="{DynamicResource AppAccent}" />
                                                                        </Border>
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                            <TextBlock Text="{Binding Title}"
                                                                                       FontSize="11"
                                                                                       FontWeight="SemiBold"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding WorkingDirectory}"
                                                                                       FontSize="9"
                                                                                       Foreground="{DynamicResource AppTextMuted}"
                                                                                       TextTrimming="PrefixCharacterEllipsis" />
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="{Binding FormattedClosedTime}"
                                                                                   FontSize="9"
                                                                                   Foreground="{DynamicResource AppTextDimmed}"
                                                                                   Margin="6,0,0,0"
                                                                                   VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Button>
                                                                <Button Grid.Column="1"
                                                                        Classes="tabCloseBtn"
                                                                        Content="×"
                                                                        Command="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).RemoveClosedTabCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip.Tip="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[ClosedTabs_RemoveTooltip]}"
                                                                        Width="18" Height="18"
                                                                        FontSize="10"
                                                                        Padding="0"
                                                                        VerticalAlignment="Center"
                                                                        Margin="2,0,2,0" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- Quick Tab List / Tab Switcher Button -->
                    <Button x:Name="TabListMenuButton"
                            Grid.Column="4"
                            Classes="tabMenuBtn"
                            ToolTip.Tip="{Binding Loc[Btn_Tab_Menu_Tooltip]}"
                            Command="{Binding ToggleTabSwitcherCommand}"
                            VerticalAlignment="Bottom"
                            Margin="2,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="≡" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="▾" FontSize="9" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Right Action Buttons: History, Settings (Gear ⚙) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Bottom" Margin="4,0,0,0">
                    <Button Classes="toolbarActionBtn"
                            ToolTip.Tip="{Binding Loc[Menu_Tab_DockBack]}"
                            Command="{Binding DockBackTabCommand}"
                            CommandParameter="{Binding SelectedTab}"
                            IsVisible="{Binding CanDockBack}"
                            Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <TextBlock Text="⇲" FontSize="12" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Loc[Menu_Tab_DockBack]}" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ToggleHistoryToolbarBtn"
                            Classes="toolbarActionBtn"
                            Content="{Binding Loc[Btn_Tab_History_Text]}"
                            ToolTip.Tip="{Binding Loc[Btn_Tab_History_Tooltip]}" />

                    <!-- Settings Button (Gear ⚙) with Flyout Menu -->
                    <controls:SettingsMenuButton x:Name="SettingsMenuBtn" />
                </StackPanel>
            </Grid>
        </Border>
        </LayoutTransformControl>

        <!-- Active Tab Content Area with Left Hover Overlay & Modals -->
        <Grid x:Name="TerminalContentArea" Grid.Row="1" Background="{DynamicResource AppContentBackground}" DragDrop.AllowDrop="True">
            <!-- Persistent Terminal Content per Tab -->
            <ItemsControl x:Name="TabContentControl"
                          ItemsSource="{Binding Tabs}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          IsVisible="{Binding HasOpenTabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Panel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:TerminalTabViewModel">
                        <views:TerminalTabView IsVisible="{Binding IsSelected}"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty State / Welcome Dashboard when 0 tabs are open (REQ-UI-008) -->
            <dialogs:WelcomeDashboardView x:Name="WelcomeDashboard" />

            <!-- ========================================== -->
            <!-- Centered History Overlay Panel with Backdrop (REQ-TAB-012) -->
            <!-- ========================================== -->
            <dialogs:HistoryDrawerView x:Name="HistoryDrawer" />

            <!-- Modal Dialog for Help (F1) -->
            <dialogs:HelpModalView x:Name="HelpModal"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   IsVisible="False"
                                   ZIndex="50" />

            <!-- Modal Dialog for About -->
            <dialogs:AboutModalView x:Name="AboutModal"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    IsVisible="False"
                                    ZIndex="60" />

            <!-- Modal Dialog for Terminal Profiles Management -->
            <dialogs:ProfilesModalView x:Name="ProfilesModal"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       IsVisible="{Binding IsProfilesModalOpen}"
                                       ZIndex="60" />

            <!-- ========================================== -->
            <!-- Unified Tab Switcher HUD Overlay (Ctrl+Tab & Tab Bar Button) (REQ-TAB-019) -->
            <!-- ========================================== -->
            <dialogs:TabSwitcherOverlayView x:Name="TabSwitcherOverlay" />
        </Grid>

        <!-- Bottom Terminal Status Bar (Outside Terminal Viewport) -->
        <controls:StatusBarView x:Name="StatusBar" Grid.Row="2" />
    </Grid>
</Window>
