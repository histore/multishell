<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MultiShell.ViewModels"
        xmlns:views="using:MultiShell.Views"
        xmlns:services="using:MultiShell.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen"
        x:Class="MultiShell.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/multishell.ico"
        Background="{DynamicResource AppWindowBackground}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Shift+T" Command="{Binding AddNewTabCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+D" Command="{Binding DuplicateTabCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+W" Command="{Binding CloseSelectedTabCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <!-- Inactive Tab Button Style -->
        <Style Selector="Button.tabBtn">
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextDimmed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="4,4,0,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="1,0,1,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tabBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderHover}" />
        </Style>

        <!-- Active Tab Button Style -->
        <Style Selector="Button.tabBtn.active">
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceActive}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}" />
            <Setter Property="BorderThickness" Value="1,2,1,0" />
            <Setter Property="Margin" Value="1,0,1,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Close Tab Button Inside Tab -->
        <Style Selector="Button.tabCloseBtn">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tabCloseBtn:pointerover">
            <Setter Property="Background" Value="#33FF0055" />
            <Setter Property="Foreground" Value="{DynamicResource AppDanger}" />
        </Style>

        <!-- Add Tab (+) Button Style -->
        <Style Selector="Button.addTabBtn">
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextDimmed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="4,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.addTabBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderHover}" />
        </Style>

        <!-- Shell Selector Dropdown Button (▾) Style -->
        <Style Selector="Button.tabShellDropdownBtn">
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextDimmed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="0,1,1,0" />
            <Setter Property="CornerRadius" Value="0,4,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tabShellDropdownBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderHover}" />
        </Style>

        <!-- Tab Scroll Buttons (◀ / ▶) -->
        <Style Selector="Button.tabScrollBtn">
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextDimmed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="4,4,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0,1,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tabScrollBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        </Style>

        <!-- Tab Dropdown Menu Button Style -->
        <Style Selector="Button.tabMenuBtn">
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextDimmed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="4,4,0,0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="1,0,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tabMenuBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        </Style>

        <!-- Tab Switcher ListBox Styles -->
        <Style Selector="ListBox.tabSwitcherListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style Selector="ListBox.tabSwitcherListBox ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}" />
        </Style>
        <Style Selector="ListBox.tabSwitcherListBox ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        </Style>
        <Style Selector="ListBox.tabSwitcherListBox ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        </Style>
        <Style Selector="Button.tabSwitcherCloseBtn">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBox.tabSwitcherListBox ListBoxItem:pointerover Button.tabSwitcherCloseBtn">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="ListBox.tabSwitcherListBox ListBoxItem Button.tabSwitcherCloseBtn:pointerover">
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Background" Value="{DynamicResource AppDangerSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource AppDanger}" />
        </Style>

        <!-- Header Action Buttons (History, Settings) -->
        <Style Selector="Button.toolbarActionBtn">
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextDimmed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="CornerRadius" Value="4,4,0,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="1,0,1,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Segoe UI, Inter, sans-serif" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.toolbarActionBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}" />
        </Style>

        <!-- History Drawer TabControl Styles -->
        <Style Selector="TabControl.historyTabs">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="12,8,12,12" />
        </Style>
        <Style Selector="TabControl.historyTabs TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="CornerRadius" Value="4,4,0,0" />
            <Setter Property="FontFamily" Value="Consolas, Cascadia Code, monospace" />
        </Style>
        <Style Selector="TabControl.historyTabs TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource AppAccent}" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBackground}" />
        </Style>

        <!-- History ListBox Styles -->
        <Style Selector="ListBox.historyListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.AllowAutoHide" Value="False" />
        </Style>
        <Style Selector="ListBox.historyListBox ScrollViewer">
            <Setter Property="AllowAutoHide" Value="False" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style Selector="ListBox.historyListBox ListBoxItem">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}" />
        </Style>
        <Style Selector="ListBox.historyListBox ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        </Style>
        <Style Selector="ListBox.historyListBox ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        </Style>

        <!-- Modal Dialog Styles -->
        <Style Selector="Border.modalDialog">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceModal}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BoxShadow" Value="0 12 32 0 #99000000" />
        </Style>
        <Style Selector="Border.modalSection">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceSubtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Border.kbdBadge">
            <Setter Property="Background" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderHover}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,2" />
        </Style>

        <!-- Level Button Style for Font Size 1..5 Selectors -->
        <Style Selector="Button.levelBtn">
            <Setter Property="Height" Value="26" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.levelBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        </Style>
        <Style Selector="Button.levelBtn.active">
            <Setter Property="Background" Value="{DynamicResource AppAccent}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Language Button Style -->
        <Style Selector="Button.langBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextDimmed}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.langBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        </Style>
        <Style Selector="Button.langBtn.active">
            <Setter Property="Background" Value="{DynamicResource AppAccent}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Empty State Profile Card Button Styles (REQ-UI-008) -->
        <Style Selector="Button.profileCardBtn">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.profileCardBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}" />
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *">
        <!-- Top Toolbar Header Bar -->
        <LayoutTransformControl Grid.Row="0">
            <LayoutTransformControl.LayoutTransform>
                <ScaleTransform ScaleX="{Binding AppFontScale}" ScaleY="{Binding AppFontScale}" />
            </LayoutTransformControl.LayoutTransform>
            <Border Background="{DynamicResource AppHeaderBackground}" BorderBrush="{DynamicResource AppBorderSubtle}" BorderThickness="0,0,0,1" Padding="6,4,6,0">
            <Grid ColumnDefinitions="*, Auto">
                <!-- Tab Bar with Overflow Navigation -->
                <Grid x:Name="TabBarContainer" Grid.Column="0" ColumnDefinitions="Auto, *, Auto, Auto, Auto" Margin="0,0,6,0" Background="Transparent">
                    <!-- Left Scroll Arrow Button -->
                    <Button x:Name="TabScrollLeftBtn"
                            Grid.Column="0"
                            Classes="tabScrollBtn"
                            Content="‹"
                            ToolTip.Tip="{Binding Loc[Btn_Tab_Scroll_Left]}"
                            IsVisible="False"
                            VerticalAlignment="Bottom"
                            Margin="0,0,2,0" />

                    <!-- Scrollable Tabs Area with Edge Gradient Overlays -->
                    <Grid Grid.Column="1">
                        <ScrollViewer x:Name="TabsScrollViewer"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      Background="Transparent">
                            <!-- Tabs List -->
                            <ItemsControl x:Name="TabsItemsControl" ItemsSource="{Binding Tabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Bottom" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TerminalTabViewModel">
                                        <Button Classes="tabBtn"
                                                Classes.active="{Binding IsSelected}"
                                                ToolTip.Tip="{Binding TabTooltip}"
                                                ToolTip.ShowDelay="150"
                                                Command="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).SelectTabCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Background="{DynamicResource AppSurfaceSubtle}"
                                                        CornerRadius="3"
                                                        Padding="3,1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ShellIconTag}"
                                                               FontFamily="Consolas, Cascadia Code, monospace"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource AppAccent}"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding DisplayTitle}"
                                                           VerticalAlignment="Center"
                                                           MaxWidth="180"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Button Classes="tabCloseBtn"
                                                        Content="×"
                                                        Command="{Binding RequestCloseCommand}"
                                                        ToolTip.Tip="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Btn_Tab_Close_Tooltip]}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Left Edge Gradient Indicator -->
                        <Border x:Name="LeftEdgeFade"
                                HorizontalAlignment="Left"
                                Width="20"
                                IsHitTestVisible="False"
                                IsVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                    <GradientStop Offset="0.0" Color="#B30C0D12" />
                                    <GradientStop Offset="1.0" Color="#000C0D12" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Right Edge Gradient Indicator -->
                        <Border x:Name="RightEdgeFade"
                                HorizontalAlignment="Right"
                                Width="20"
                                IsHitTestVisible="False"
                                IsVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                    <GradientStop Offset="0.0" Color="#000C0D12" />
                                    <GradientStop Offset="1.0" Color="#B30C0D12" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <!-- Right Scroll Arrow Button (placed immediately left of Add Tab button) -->
                    <Button x:Name="TabScrollRightBtn"
                            Grid.Column="2"
                            Classes="tabScrollBtn"
                            Content="›"
                            ToolTip.Tip="{Binding Loc[Btn_Tab_Scroll_Right]}"
                            IsVisible="False"
                            VerticalAlignment="Bottom"
                            Margin="2,0,2,0" />

                    <!-- Docked Add Tab (+) and Shell Selector (▾) Buttons -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="0" VerticalAlignment="Bottom">
                        <Button Classes="addTabBtn"
                                Content="+"
                                ToolTip.Tip="{Binding NewTabTooltip}"
                                Command="{Binding AddNewTabCommand}"
                                VerticalAlignment="Bottom" />
                        <Button Classes="tabShellDropdownBtn"
                                Content="▾"
                                ToolTip.Tip="{Binding Loc[Btn_Select_Shell_Tooltip]}"
                                VerticalAlignment="Bottom">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <Border Background="{DynamicResource AppSurfaceModal}"
                                            BorderBrush="{DynamicResource AppBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="4"
                                            MinWidth="240"
                                            MaxWidth="320">
                                        <StackPanel Spacing="4">
                                            <!-- Profiles List -->
                                            <ItemsControl ItemsSource="{Binding Profiles}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:TerminalProfileItemViewModel">
                                                        <Button Classes="tabMenuItemBtn"
                                                                Command="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).AddNewTabWithProfileCommand}"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding IsAvailable}"
                                                                HorizontalAlignment="Stretch">
                                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                                <Border Background="{DynamicResource AppSurfaceSubtle}"
                                                                        CornerRadius="3"
                                                                        Padding="4,2"
                                                                        Margin="0,0,8,0"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding IconTag}"
                                                                               FontFamily="Consolas, Cascadia Code, monospace"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               Foreground="{DynamicResource AppAccent}" />
                                                                </Border>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Name}"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="12" />
                                                                <TextBlock Grid.Column="2"
                                                                           Text="✓"
                                                                           IsVisible="{Binding IsAvailable}"
                                                                           Foreground="{DynamicResource AppSuccess}"
                                                                           FontSize="11"
                                                                           Margin="6,0,0,0"
                                                                           VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Recently Closed Tabs Section (REQ-TAB-021) -->
                                            <StackPanel IsVisible="{Binding HasClosedTabs}" Spacing="2" Margin="0,4,0,0">
                                                <Border Height="1" Background="{DynamicResource AppBorderSubtle}" Margin="0,2,0,4" />
                                                <Grid ColumnDefinitions="*, Auto" Margin="6,2,6,4">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Loc[ClosedTabs_Title]}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource AppTextMuted}"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="1"
                                                            Classes="tabMenuItemBtn"
                                                            Content="{Binding Loc[ClosedTabs_ClearAll]}"
                                                            Command="{Binding ClearClosedTabsCommand}"
                                                            FontSize="9"
                                                            Padding="4,1"
                                                            Foreground="{DynamicResource AppTextDimmed}"
                                                            VerticalAlignment="Center" />
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding ClosedTabs}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ClosedTabItemViewModel">
                                                            <Grid ColumnDefinitions="*, Auto" Margin="0,1">
                                                                <Button Grid.Column="0"
                                                                        Classes="tabMenuItemBtn"
                                                                        Command="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).RestoreClosedTabCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip.Tip="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[ClosedTabs_RestoreTooltip]}"
                                                                        HorizontalAlignment="Stretch">
                                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                                        <Border Background="{DynamicResource AppSurfaceSubtle}"
                                                                                CornerRadius="3"
                                                                                Padding="4,2"
                                                                                Margin="0,0,8,0"
                                                                                VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding ShellIconTag}"
                                                                                       FontFamily="Consolas, Cascadia Code, monospace"
                                                                                       FontSize="9"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="{DynamicResource AppAccent}" />
                                                                        </Border>
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                            <TextBlock Text="{Binding Title}"
                                                                                       FontSize="11"
                                                                                       FontWeight="SemiBold"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding WorkingDirectory}"
                                                                                       FontSize="9"
                                                                                       Foreground="{DynamicResource AppTextMuted}"
                                                                                       TextTrimming="PrefixCharacterEllipsis" />
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="{Binding FormattedClosedTime}"
                                                                                   FontSize="9"
                                                                                   Foreground="{DynamicResource AppTextDimmed}"
                                                                                   Margin="6,0,0,0"
                                                                                   VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Button>
                                                                <Button Grid.Column="1"
                                                                        Classes="tabCloseBtn"
                                                                        Content="×"
                                                                        Command="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).RemoveClosedTabCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip.Tip="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[ClosedTabs_RemoveTooltip]}"
                                                                        Width="18" Height="18"
                                                                        FontSize="10"
                                                                        Padding="0"
                                                                        VerticalAlignment="Center"
                                                                        Margin="2,0,2,0" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- Quick Tab List / Tab Switcher Button -->
                    <Button x:Name="TabListMenuButton"
                            Grid.Column="4"
                            Classes="tabMenuBtn"
                            ToolTip.Tip="{Binding Loc[Btn_Tab_Menu_Tooltip]}"
                            Command="{Binding ToggleTabSwitcherCommand}"
                            VerticalAlignment="Bottom"
                            Margin="2,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="≡" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="▾" FontSize="9" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Right Action Buttons: History, Settings (Gear ⚙) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Bottom" Margin="4,0,0,0">
                    <Button x:Name="ToggleHistoryToolbarBtn"
                            Classes="toolbarActionBtn"
                            Content="{Binding Loc[Btn_Tab_History_Text]}"
                            ToolTip.Tip="{Binding Loc[Btn_Tab_History_Tooltip]}" />

                    <!-- Settings Button (Gear ⚙) with Flyout Menu -->
                    <Button x:Name="SettingsToolbarBtn"
                            Classes="toolbarActionBtn"
                            ToolTip.Tip="{Binding Loc[Settings_Menu_Title]}">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <TextBlock Text="⚙" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="▾" FontSize="9" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Border Background="{DynamicResource AppSurfaceSubtle}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="6" Padding="6" MinWidth="260">
                                    <StackPanel Spacing="2">
                                        <!-- App Theme Toggle Item -->
                                        <Button Classes="tabMenuItemBtn"
                                                Command="{Binding ToggleAppThemeCommand}"
                                                HorizontalAlignment="Stretch"
                                                ToolTip.Tip="Switch App UI between Dark and Light theme">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Loc[Settings_App_Theme]}" FontSize="12" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Loc[Theme_Dark]}" FontSize="11" Foreground="{DynamicResource AppAccent}" IsVisible="{Binding IsDarkAppTheme}" />
                                                    <TextBlock Text="{Binding Loc[Theme_Light]}" FontSize="11" Foreground="#E0AF68" IsVisible="{Binding !IsDarkAppTheme}" />
                                                    <TextBlock Text="●" FontSize="8" Foreground="{DynamicResource AppSuccess}" VerticalAlignment="Center" Margin="2,0,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- Terminal Theme Toggle Item -->
                                        <Button Classes="tabMenuItemBtn"
                                                Command="{Binding ToggleTerminalThemeCommand}"
                                                HorizontalAlignment="Stretch"
                                                ToolTip.Tip="{Binding Loc[Settings_Terminal_Theme]}">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Loc[Settings_Terminal_Theme]}" FontSize="12" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Loc[Theme_Dark]}" FontSize="11" Foreground="{DynamicResource AppAccent}" IsVisible="{Binding IsDarkTerminalTheme}" />
                                                    <TextBlock Text="{Binding Loc[Theme_Light]}" FontSize="11" Foreground="#E0AF68" IsVisible="{Binding !IsDarkTerminalTheme}" />
                                                    <TextBlock Text="●" FontSize="8" Foreground="{DynamicResource AppSuccess}" VerticalAlignment="Center" Margin="2,0,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- Language Selector Section -->
                                        <Border Classes="modalSection" Margin="0,2" Padding="8,6">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Loc[Settings_Language]}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CurrentLanguageUpper}"
                                                                   FontFamily="Consolas, monospace"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource AppAccent}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                                <Border Background="{DynamicResource AppSurfaceBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="4" Padding="2">
                                                    <Grid ColumnDefinitions="*,*,*,*">
                                                        <Button Grid.Column="0"
                                                                Classes="levelBtn"
                                                                Classes.active="{Binding IsGerman}"
                                                                Command="{Binding SelectLanguageCommand}"
                                                                CommandParameter="de"
                                                                HorizontalAlignment="Stretch"
                                                                ToolTip.Tip="Deutsch (German)">
                                                            <TextBlock Text="DE" />
                                                        </Button>
                                                        <Button Grid.Column="1"
                                                                Classes="levelBtn"
                                                                Classes.active="{Binding IsEnglish}"
                                                                Command="{Binding SelectLanguageCommand}"
                                                                CommandParameter="en"
                                                                HorizontalAlignment="Stretch"
                                                                ToolTip.Tip="English (Default Fallback)">
                                                            <TextBlock Text="EN" />
                                                        </Button>
                                                        <Button Grid.Column="2"
                                                                Classes="levelBtn"
                                                                Classes.active="{Binding IsFrench}"
                                                                Command="{Binding SelectLanguageCommand}"
                                                                CommandParameter="fr"
                                                                HorizontalAlignment="Stretch"
                                                                ToolTip.Tip="Français (French)">
                                                            <TextBlock Text="FR" />
                                                        </Button>
                                                        <Button Grid.Column="3"
                                                                Classes="levelBtn"
                                                                Classes.active="{Binding IsSpanish}"
                                                                Command="{Binding SelectLanguageCommand}"
                                                                CommandParameter="es"
                                                                HorizontalAlignment="Stretch"
                                                                ToolTip.Tip="Español (Spanish)">
                                                            <TextBlock Text="ES" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- App Font Size Selector -->
                                        <Border Classes="modalSection" Margin="0,2" Padding="8,6">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Loc[Settings_App_FontSize]}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AppFontSizeLevel, StringFormat='{}L{0}'}" FontSize="10" FontFamily="Consolas, monospace" FontWeight="Bold" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                                <Border Background="{DynamicResource AppSurfaceBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="4" Padding="2">
                                                    <Grid ColumnDefinitions="*,*,*,*,*">
                                                        <Button Grid.Column="0" Classes="levelBtn" Classes.active="{Binding IsAppFontSizeLevel1}" Command="{Binding SetAppFontSizeLevelCommand}" CommandParameter="1" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Loc[FontSize_Level_1]}">
                                                            <TextBlock Text="1" />
                                                        </Button>
                                                        <Button Grid.Column="1" Classes="levelBtn" Classes.active="{Binding IsAppFontSizeLevel2}" Command="{Binding SetAppFontSizeLevelCommand}" CommandParameter="2" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Loc[FontSize_Level_2]}">
                                                            <TextBlock Text="2" />
                                                        </Button>
                                                        <Button Grid.Column="2" Classes="levelBtn" Classes.active="{Binding IsAppFontSizeLevel3}" Command="{Binding SetAppFontSizeLevelCommand}" CommandParameter="3" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Loc[FontSize_Level_3]}">
                                                            <TextBlock Text="3" />
                                                        </Button>
                                                        <Button Grid.Column="3" Classes="levelBtn" Classes.active="{Binding IsAppFontSizeLevel4}" Command="{Binding SetAppFontSizeLevelCommand}" CommandParameter="4" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Loc[FontSize_Level_4]}">
                                                            <TextBlock Text="4" />
                                                        </Button>
                                                        <Button Grid.Column="4" Classes="levelBtn" Classes.active="{Binding IsAppFontSizeLevel5}" Command="{Binding SetAppFontSizeLevelCommand}" CommandParameter="5" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Loc[FontSize_Level_5]}">
                                                            <TextBlock Text="5" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Terminal Font Size Selector -->
                                        <Border Classes="modalSection" Margin="0,2" Padding="8,6">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Loc[Settings_Terminal_FontSize]}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondary}" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TerminalFontSize, StringFormat='{}{0:0.#} pt'}" FontSize="10" FontFamily="Consolas, monospace" FontWeight="Bold" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                                <Border Background="{DynamicResource AppSurfaceBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="4" Padding="2">
                                                    <Grid ColumnDefinitions="*,*,*,*,*">
                                                        <Button Grid.Column="0" Classes="levelBtn" Classes.active="{Binding IsTerminalFontSizeLevel1}" Command="{Binding SetTerminalFontSizeLevelCommand}" CommandParameter="1" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Loc[FontSize_Level_1]}">
                                                            <TextBlock Text="1" />
                                                        </Button>
                                                        <Button Grid.Column="1" Classes="levelBtn" Classes.active="{Binding IsTerminalFontSizeLevel2}" Command="{Binding SetTerminalFontSizeLevelCommand}" CommandParameter="2" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Loc[FontSize_Level_2]}">
                                                            <TextBlock Text="2" />
                                                        </Button>
                                                        <Button Grid.Column="2" Classes="levelBtn" Classes.active="{Binding IsTerminalFontSizeLevel3}" Command="{Binding SetTerminalFontSizeLevelCommand}" CommandParameter="3" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Loc[FontSize_Level_3]}">
                                                            <TextBlock Text="3" />
                                                        </Button>
                                                        <Button Grid.Column="3" Classes="levelBtn" Classes.active="{Binding IsTerminalFontSizeLevel4}" Command="{Binding SetTerminalFontSizeLevelCommand}" CommandParameter="4" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Loc[FontSize_Level_4]}">
                                                            <TextBlock Text="4" />
                                                        </Button>
                                                        <Button Grid.Column="4" Classes="levelBtn" Classes.active="{Binding IsTerminalFontSizeLevel5}" Command="{Binding SetTerminalFontSizeLevelCommand}" CommandParameter="5" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Loc[FontSize_Level_5]}">
                                                            <TextBlock Text="5" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Rectangle Height="1" Fill="{DynamicResource AppBorder}" Margin="0,4" />

                                        <!-- Terminal Profiles Management Item -->
                                        <Button x:Name="SettingsProfilesMenuItem"
                                                Classes="tabMenuItemBtn"
                                                HorizontalAlignment="Stretch">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Loc[Settings_Profiles_Title]}" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="⚙" FontSize="11" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>

                                        <!-- Help Item -->
                                        <Button x:Name="SettingsHelpMenuItem"
                                                Classes="tabMenuItemBtn"
                                                HorizontalAlignment="Stretch">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Loc[Settings_Help_Title]}" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="F1" FontFamily="Consolas, monospace" FontSize="10" Foreground="{DynamicResource AppTextMuted}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>

                                        <!-- About Item -->
                                        <Button x:Name="SettingsAboutMenuItem"
                                                Classes="tabMenuItemBtn"
                                                HorizontalAlignment="Stretch">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Loc[Settings_About_Title]}" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding AppVersion}" FontFamily="Consolas, monospace" FontSize="10" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        </LayoutTransformControl>

        <!-- Active Tab Content Area with Left Hover Overlay & Modals -->
        <Grid Grid.Row="1" Background="{DynamicResource AppContentBackground}">
            <!-- Persistent Terminal Content per Tab -->
            <ItemsControl x:Name="TabContentControl"
                          ItemsSource="{Binding Tabs}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          IsVisible="{Binding HasOpenTabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Panel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:TerminalTabViewModel">
                        <views:TerminalTabView IsVisible="{Binding IsSelected}"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty State / Welcome Dashboard when 0 tabs are open (REQ-UI-008) -->
            <Grid IsVisible="{Binding HasNoTabs}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource AppContentBackground}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="24"
                                Margin="32"
                                MaxWidth="720">
                        
                        <!-- Logo & Welcome Header -->
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <Border Width="64" Height="64"
                                    Background="{DynamicResource AppSurfaceSubtle}"
                                    BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    HorizontalAlignment="Center"
                                    BoxShadow="0 4 16 0 #33000000">
                                <TextBlock Text=">_"
                                           FontFamily="Consolas, monospace"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppAccent}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Loc[EmptyState_Title]}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimary}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Loc[EmptyState_Description]}"
                                       FontSize="13"
                                       Foreground="{DynamicResource AppTextSecondary}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </StackPanel>

                        <!-- Profile Cards Grid / Selector -->
                        <Border Background="{DynamicResource AppSurfaceSubtle}"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20"
                                BoxShadow="0 2 12 0 #22000000">
                            <StackPanel Spacing="14">
                                <TextBlock Text="{Binding Loc[EmptyState_QuickLaunch]}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           LetterSpacing="1"
                                           Foreground="{DynamicResource AppTextMuted}" />

                                <ItemsControl ItemsSource="{Binding Profiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:TerminalProfileItemViewModel">
                                            <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AddNewTabWithProfileCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="profileCardBtn"
                                                    Margin="0,0,12,12"
                                                    Width="200"
                                                    Padding="12,10"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource AppSurfaceBackground}"
                                                    BorderBrush="{DynamicResource AppBorderSubtle}"
                                                    BorderThickness="1"
                                                    HorizontalContentAlignment="Stretch"
                                                    Cursor="Hand">
                                                <Grid ColumnDefinitions="Auto, *">
                                                    <Border Grid.Column="0"
                                                            Background="{DynamicResource AppSurfaceSubtle}"
                                                            BorderBrush="{DynamicResource AppBorder}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="6,4"
                                                            MinWidth="36"
                                                            Margin="0,0,10,0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding IconTag}"
                                                                   FontFamily="Consolas, monospace"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource AppAccent}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppTextPrimary}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ExecutablePath}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource AppTextMuted}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Recently Closed Tabs Card (REQ-TAB-021) -->
                        <Border IsVisible="{Binding HasClosedTabs}"
                                Background="{DynamicResource AppSurfaceSubtle}"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20"
                                BoxShadow="0 2 12 0 #22000000">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Loc[ClosedTabs_EmptyStateTitle]}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               LetterSpacing="1"
                                               Foreground="{DynamicResource AppTextMuted}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Classes="tabMenuItemBtn"
                                            Content="{Binding Loc[ClosedTabs_ClearAll]}"
                                            Command="{Binding ClearClosedTabsCommand}"
                                            FontSize="10"
                                            Padding="6,2"
                                            Foreground="{DynamicResource AppTextDimmed}"
                                            VerticalAlignment="Center" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding ClosedTabs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ClosedTabItemViewModel">
                                            <Border Margin="0,0,12,12"
                                                    Width="210"
                                                    Background="{DynamicResource AppSurfaceBackground}"
                                                    BorderBrush="{DynamicResource AppBorderSubtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <Button Grid.Column="0"
                                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RestoreClosedTabCommand}"
                                                            CommandParameter="{Binding}"
                                                            Classes="profileCardBtn"
                                                            Padding="10,8"
                                                            CornerRadius="8,0,0,8"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            HorizontalContentAlignment="Stretch"
                                                            ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Loc[ClosedTabs_RestoreTooltip]}"
                                                            Cursor="Hand">
                                                        <Grid ColumnDefinitions="Auto, *">
                                                            <Border Grid.Column="0"
                                                                    Background="{DynamicResource AppSurfaceSubtle}"
                                                                    BorderBrush="{DynamicResource AppBorder}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    Padding="4,2"
                                                                    MinWidth="30"
                                                                    Margin="0,0,8,0"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ShellIconTag}"
                                                                           FontFamily="Consolas, monospace"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource AppAccent}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AppTextPrimary}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding WorkingDirectory}"
                                                                           FontSize="9"
                                                                           Foreground="{DynamicResource AppTextMuted}"
                                                                           TextTrimming="PrefixCharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                    <Button Grid.Column="1"
                                                            Classes="tabCloseBtn"
                                                            Content="×"
                                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveClosedTabCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="{Binding $parent[Window].((vm:MainViewModel)DataContext).Loc[ClosedTabs_RemoveTooltip]}"
                                                            Width="22" Height="22"
                                                            FontSize="11"
                                                            Padding="0"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,4,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Keyboard Shortcut Guide Hint -->
                        <TextBlock Text="{Binding Loc[EmptyState_ShortcutsHint]}"
                                   FontFamily="Consolas, monospace"
                                   FontSize="11"
                                   Foreground="{DynamicResource AppTextMuted}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.8" />

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Left Edge Hover Trigger Indicator -->
            <Border x:Name="HistoryHoverTrigger"
                    HorizontalAlignment="Left"
                    Width="10"
                    Background="Transparent"
                    ZIndex="10">
                <Border Width="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource AppBorder}"
                        Opacity="0.6"
                        Margin="1,0,0,0" />
            </Border>

            <!-- History Flyout Overlay Panel taking 90% width -->
            <Grid x:Name="HistoryDrawer"
                  HorizontalAlignment="Stretch"
                  IsVisible="False"
                  ZIndex="20"
                  ColumnDefinitions="9*, 1*">
                <!-- 90% Overlay Container -->
                <Border Grid.Column="0"
                        Background="{DynamicResource AppWindowBackground}"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="0,0,1,0"
                        BoxShadow="8 0 24 0 #AA000000">
                    <Grid RowDefinitions="Auto, *">
                        <!-- Drawer Header -->
                        <Border Grid.Row="0" Background="{DynamicResource AppHeaderBackground}" BorderBrush="{DynamicResource AppBorderSubtle}" BorderThickness="0,0,0,1" Padding="12,8">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Loc[Drawer_Title]}" FontFamily="Consolas, Cascadia Code, monospace" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center" />
                                    <TextBlock Text="[ ▲/▼ Navigate  |  Enter Execute  |  Esc Close ]" FontFamily="Consolas, monospace" FontSize="10" Foreground="{DynamicResource AppTextMuted}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="✕"
                                        x:Name="CloseHistoryButton"
                                        Background="Transparent"
                                        Foreground="{DynamicResource AppTextMuted}"
                                        Padding="6,2"
                                        FontSize="11" />
                            </Grid>
                        </Border>

                        <!-- Drawer Content: TabControl for Commands and Directories -->
                        <TabControl x:Name="HistoryTabControl" Grid.Row="1" Classes="historyTabs">
                            <!-- Tab 1: Commands -->
                            <TabItem Header="{Binding Loc[Drawer_Tab_Commands]}">
                                <Grid RowDefinitions="Auto, *">
                                    <!-- Search Filter Box -->
                                    <Border Grid.Row="0"
                                            Background="{DynamicResource AppSurfaceSubtle}"
                                            BorderBrush="{DynamicResource AppBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,6,0,6"
                                            Padding="4">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Margin="6,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMuted}" />
                                            <TextBox Grid.Column="1"
                                                     x:Name="CommandHistorySearchBox"
                                                     Text="{Binding SelectedTab.CommandFilterQuery, Mode=TwoWay}"
                                                     PlaceholderText="{Binding Loc[Drawer_Search_Commands_Placeholder]}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     FontSize="12"
                                                     VerticalAlignment="Center" />
                                            <Button Grid.Column="2"
                                                    x:Name="ClearCommandFilterBtn"
                                                    Content="✕"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource AppTextMuted}"
                                                    FontSize="10"
                                                    Padding="4,2"
                                                    IsVisible="{Binding !!SelectedTab.CommandFilterQuery.Length}" />
                                        </Grid>
                                    </Border>

                                    <!-- Command List -->
                                    <Border Grid.Row="1" Background="{DynamicResource AppSurfaceSubtle}" CornerRadius="6" Padding="4" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
                                        <Grid>
                                            <ListBox x:Name="CommandHistoryListBox"
                                                     Classes="historyListBox"
                                                     SelectionMode="Single"
                                                     Focusable="True"
                                                     ItemsSource="{Binding SelectedTab.FilteredCommandHistory}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Grid ColumnDefinitions="Auto, *">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="> "
                                                                       FontFamily="Consolas, Cascadia Code, monospace"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource AppSuccess}"
                                                                       Margin="0,0,4,0" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding}"
                                                                       FontFamily="Consolas, Cascadia Code, monospace"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource AppTextSecondary}"
                                                                       TextWrapping="Wrap" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock Text="{Binding Loc[Drawer_Empty_Commands]}"
                                                       Foreground="{DynamicResource AppTextMuted}"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding !SelectedTab.FilteredCommandHistory.Count}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- Tab 2: Directories -->
                            <TabItem Header="{Binding Loc[Drawer_Tab_Directories]}">
                                <Grid RowDefinitions="Auto, *">
                                    <!-- Search Filter Box -->
                                    <Border Grid.Row="0"
                                            Background="{DynamicResource AppSurfaceSubtle}"
                                            BorderBrush="{DynamicResource AppBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,6,0,6"
                                            Padding="4">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Margin="6,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource AppTextMuted}" />
                                            <TextBox Grid.Column="1"
                                                     x:Name="DirectoryHistorySearchBox"
                                                     Text="{Binding SelectedTab.DirectoryFilterQuery, Mode=TwoWay}"
                                                     PlaceholderText="{Binding Loc[Drawer_Search_Directories_Placeholder]}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     FontSize="12"
                                                     VerticalAlignment="Center" />
                                            <Button Grid.Column="2"
                                                    x:Name="ClearDirectoryFilterBtn"
                                                    Content="✕"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource AppTextMuted}"
                                                    FontSize="10"
                                                    Padding="4,2"
                                                    IsVisible="{Binding !!SelectedTab.DirectoryFilterQuery.Length}" />
                                        </Grid>
                                    </Border>

                                    <!-- Directory List -->
                                    <Border Grid.Row="1" Background="{DynamicResource AppSurfaceSubtle}" CornerRadius="6" Padding="4" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
                                        <Grid>
                                            <ListBox x:Name="DirectoryHistoryListBox"
                                                     Classes="historyListBox"
                                                     SelectionMode="Single"
                                                     Focusable="True"
                                                     ItemsSource="{Binding SelectedTab.FilteredDirectoryHistory}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Grid ColumnDefinitions="Auto, *">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="/ "
                                                                       FontFamily="Consolas, Cascadia Code, monospace"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource AppAccent}"
                                                                       Margin="0,0,4,0" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding}"
                                                                       FontFamily="Consolas, Cascadia Code, monospace"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource AppTextSecondary}"
                                                                       TextWrapping="Wrap" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock Text="{Binding Loc[Drawer_Empty_Directories]}"
                                                       Foreground="{DynamicResource AppTextMuted}"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding !SelectedTab.FilteredDirectoryHistory.Count}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>

                <!-- Remaining 10% backdrop area closing drawer when clicked -->
                <Border Grid.Column="1"
                        x:Name="HistoryBackdrop"
                        Background="#22000000" />
            </Grid>

            <!-- Modal Backdrop & Dialog for Help (F1) -->
            <Grid x:Name="HelpModal"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource AppModalOverlay}"
                  IsVisible="False"
                  ZIndex="50">
                <Border Classes="modalDialog"
                        Width="560"
                        MaxHeight="500"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="18">
                    <Grid RowDefinitions="Auto, *, Auto">
                        <!-- Modal Title Bar -->
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,14">
                            <TextBlock Grid.Column="0" Text="{Binding Loc[Help_Modal_Title]}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="CloseHelpModalButton" Content="✕" Background="Transparent" Foreground="{DynamicResource AppTextMuted}" FontSize="12" Padding="4,2" />
                        </Grid>

                        <!-- Content Area -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <!-- Keyboard Shortcuts Section -->
                                <Border Classes="modalSection">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding Loc[Help_Section_Navigation]}" FontFamily="Consolas, monospace" FontWeight="Bold" Foreground="{DynamicResource AppAccent}" FontSize="11" />
                                        <Grid ColumnDefinitions="160, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto">
                                             <Border Grid.Row="0" Grid.Column="0" Classes="kbdBadge" Margin="0,2,8,2" HorizontalAlignment="Left">
                                                 <TextBlock Text="Ctrl + Shift + T" FontFamily="Consolas, monospace" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" />
                                             </Border>
                                             <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Loc[Help_Tab_New]}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextKbd}" FontSize="12" />

                                             <Border Grid.Row="1" Grid.Column="0" Classes="kbdBadge" Margin="0,2,8,2" HorizontalAlignment="Left">
                                                 <TextBlock Text="Ctrl + Shift + D" FontFamily="Consolas, monospace" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" />
                                             </Border>
                                             <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Loc[Help_Tab_Dup]}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextKbd}" FontSize="12" />

                                             <Border Grid.Row="2" Grid.Column="0" Classes="kbdBadge" Margin="0,2,8,2" HorizontalAlignment="Left">
                                                 <TextBlock Text="Ctrl + Tab / Shift+Tab" FontFamily="Consolas, monospace" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" />
                                             </Border>
                                             <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Loc[Help_Tab_Next_Prev]}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextKbd}" FontSize="12" />

                                             <Border Grid.Row="3" Grid.Column="0" Classes="kbdBadge" Margin="0,2,8,2" HorizontalAlignment="Left">
                                                 <TextBlock Text="Ctrl + 1..8 / Ctrl+9" FontFamily="Consolas, monospace" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" />
                                             </Border>
                                             <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Loc[Help_Tab_Jump]}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextKbd}" FontSize="12" />

                                             <Border Grid.Row="4" Grid.Column="0" Classes="kbdBadge" Margin="0,2,8,2" HorizontalAlignment="Left">
                                                 <TextBlock Text="Ctrl + Shift + W" FontFamily="Consolas, monospace" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" />
                                             </Border>
                                             <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Loc[Help_Tab_Close]}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextKbd}" FontSize="12" />

                                             <Border Grid.Row="5" Grid.Column="0" Classes="kbdBadge" Margin="0,2,8,2" HorizontalAlignment="Left">
                                                 <TextBlock Text="Ctrl + Shift + PgUp/Dn" FontFamily="Consolas, monospace" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" />
                                             </Border>
                                             <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Loc[Help_Tab_Move]}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextKbd}" FontSize="12" />

                                             <Border Grid.Row="6" Grid.Column="0" Classes="kbdBadge" Margin="0,2,8,2" HorizontalAlignment="Left">
                                                 <TextBlock Text="Ctrl + + / - / 0" FontFamily="Consolas, monospace" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" />
                                             </Border>
                                             <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Loc[Help_Zoom_Shortcuts]}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextKbd}" FontSize="12" />

                                             <Border Grid.Row="7" Grid.Column="0" Classes="kbdBadge" Margin="0,2,8,2" HorizontalAlignment="Left">
                                                 <TextBlock Text="Shift + PgUp / PgDn" FontFamily="Consolas, monospace" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" />
                                             </Border>
                                             <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Loc[Help_Scroll_Shortcuts]}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextKbd}" FontSize="12" />

                                             <Border Grid.Row="8" Grid.Column="0" Classes="kbdBadge" Margin="0,2,8,2" HorizontalAlignment="Left">
                                                 <TextBlock Text="Ctrl + Shift + K" FontFamily="Consolas, monospace" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" />
                                             </Border>
                                             <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Loc[Help_Buffer_Clear]}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextKbd}" FontSize="12" />

                                             <Border Grid.Row="9" Grid.Column="0" Classes="kbdBadge" Margin="0,2,8,2" HorizontalAlignment="Left">
                                                 <TextBlock Text="Ctrl + Shift + C / V" FontFamily="Consolas, monospace" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" />
                                             </Border>
                                             <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Loc[Help_Copy_Paste]}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextKbd}" FontSize="12" />

                                             <Border Grid.Row="10" Grid.Column="0" Classes="kbdBadge" Margin="0,2,8,2" HorizontalAlignment="Left">
                                                 <TextBlock Text="Ctrl+Enter / Shift+Enter" FontFamily="Consolas, monospace" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" />
                                             </Border>
                                             <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding Loc[Help_Term_Newline]}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextKbd}" FontSize="12" />

                                             <Border Grid.Row="11" Grid.Column="0" Classes="kbdBadge" Margin="0,2,8,2" HorizontalAlignment="Left">
                                                 <TextBlock Text="Ctrl + Shift + H" FontFamily="Consolas, monospace" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" />
                                             </Border>
                                             <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding Loc[Help_Hist_Toggle]}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextKbd}" FontSize="12" />

                                             <Border Grid.Row="12" Grid.Column="0" Classes="kbdBadge" Margin="0,2,8,2" HorizontalAlignment="Left">
                                                 <TextBlock Text="F1" FontFamily="Consolas, monospace" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" />
                                             </Border>
                                             <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding Loc[Help_Nav_F1]}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextKbd}" FontSize="12" />

                                             <Border Grid.Row="13" Grid.Column="0" Classes="kbdBadge" Margin="0,2,8,2" HorizontalAlignment="Left">
                                                 <TextBlock Text="Escape" FontFamily="Consolas, monospace" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" />
                                             </Border>
                                             <TextBlock Grid.Row="13" Grid.Column="1" Text="{Binding Loc[Help_Nav_Esc]}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextKbd}" FontSize="12" />
                                         </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Features Guide -->
                                <Border Classes="modalSection">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Loc[Help_Section_Features]}" FontFamily="Consolas, monospace" FontWeight="Bold" Foreground="{DynamicResource AppSuccess}" FontSize="11" />
                                        <TextBlock Text="{Binding Loc[Help_Feature_1]}" Foreground="{DynamicResource AppTextKbd}" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Loc[Help_Feature_2]}" Foreground="{DynamicResource AppTextKbd}" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Loc[Help_Feature_3]}" Foreground="{DynamicResource AppTextKbd}" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Loc[Help_Feature_4]}" Foreground="{DynamicResource AppTextKbd}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Close Footer Button -->
                        <Button Grid.Row="2" x:Name="OkHelpModalButton" Content="{Binding Loc[Help_Close_Button]}" HorizontalAlignment="Right" Margin="0,14,0,0" Padding="16,5" Background="{DynamicResource AppSurfaceBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Foreground="{DynamicResource AppTextPrimary}" FontSize="12" CornerRadius="4" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Modal Backdrop & Dialog for About -->
            <Grid x:Name="AboutModal"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource AppModalOverlay}"
                  IsVisible="False"
                  ZIndex="60">
                <Border Classes="modalDialog"
                        Width="450"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="20">
                    <Grid RowDefinitions="Auto, Auto, Auto, Auto">
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="4" Margin="0,0,0,14">
                            <Image Source="/Assets/multishell.png" Width="56" Height="56" Margin="0,0,0,4" HorizontalAlignment="Center" />
                            <TextBlock Text="MultiShell" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Loc[About_Modal_Subtitle]}" FontSize="11" Foreground="{DynamicResource AppAccent}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <Border Grid.Row="1" Classes="modalSection" Margin="0,0,0,14">
                            <StackPanel Spacing="5">
                                <Grid ColumnDefinitions="115, *">
                                    <TextBlock Grid.Column="0" Text="{Binding Loc[About_Version]}" Foreground="{DynamicResource AppTextMuted}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding AppVersion}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" FontSize="12" />
                                </Grid>
                                <Grid ColumnDefinitions="115, *">
                                    <TextBlock Grid.Column="0" Text="{Binding Loc[About_Framework]}" Foreground="{DynamicResource AppTextMuted}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text=".NET 10.0 / C# 13" Foreground="{DynamicResource AppTextSecondary}" FontSize="12" />
                                </Grid>
                                <Grid ColumnDefinitions="115, *">
                                    <TextBlock Grid.Column="0" Text="{Binding Loc[About_UI_Terminal]}" Foreground="{DynamicResource AppTextMuted}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="Avalonia UI 11.2 / ConPTY" Foreground="{DynamicResource AppTextSecondary}" FontSize="12" />
                                </Grid>
                                <Grid ColumnDefinitions="115, *">
                                    <TextBlock Grid.Column="0" Text="{Binding Loc[About_License]}" Foreground="{DynamicResource AppTextMuted}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="Apache-2.0" Foreground="{DynamicResource AppSuccess}" FontSize="12" />
                                </Grid>
                                <Grid ColumnDefinitions="115, *">
                                    <TextBlock Grid.Column="0" Text="{Binding Loc[About_Font]}" Foreground="{DynamicResource AppTextMuted}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding Loc[About_Font_Value]}" Foreground="{DynamicResource AppTextSecondary}" FontSize="12" />
                                </Grid>
                                <Grid ColumnDefinitions="115, *">
                                    <TextBlock Grid.Column="0" Text="{Binding Loc[About_Third_Party]}" Foreground="{DynamicResource AppTextMuted}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding Loc[About_Third_Party_Value]}" Foreground="{DynamicResource AppTextSecondary}" FontSize="12" />
                                </Grid>
                                <Grid ColumnDefinitions="115, *">
                                    <TextBlock Grid.Column="0" Text="{Binding Loc[About_GitHub]}" Foreground="{DynamicResource AppTextMuted}" FontSize="12" VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Command="{Binding OpenGitHubUrlCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Margin="0"
                                            HorizontalAlignment="Left"
                                            Cursor="Hand"
                                            ToolTip.Tip="{Binding GitHubUrl}">
                                        <TextBlock Text="github.com/histore/multishell"
                                                   Foreground="{DynamicResource AppAccent}"
                                                   TextDecorations="Underline"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="115, *">
                                    <TextBlock Grid.Column="0" Text="{Binding Loc[About_Built_With]}" Foreground="{DynamicResource AppTextMuted}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding Loc[About_Built_With_Value]}" Foreground="{DynamicResource AppAccent}" FontWeight="SemiBold" FontSize="12" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="2" Text="{Binding Loc[About_Footer]}" FontSize="11" Foreground="{DynamicResource AppTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,14" />

                        <Button Grid.Row="3" x:Name="OkAboutModalButton" Content="{Binding Loc[About_OK_Button]}" HorizontalAlignment="Center" Padding="24,5" Background="{DynamicResource AppSurfaceBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Foreground="{DynamicResource AppTextPrimary}" FontSize="12" CornerRadius="4" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Modal Backdrop & Dialog for Terminal Profiles Management -->
            <Grid x:Name="ProfilesModal"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource AppModalOverlay}"
                  IsVisible="{Binding IsProfilesModalOpen}"
                  ZIndex="60">
                <Border Classes="modalDialog"
                        Width="620"
                        MaxHeight="560"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="18">
                    <Grid RowDefinitions="Auto, *, Auto">
                        <!-- Modal Title Bar -->
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Loc[Profiles_Modal_Title]}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" />
                                <TextBlock Text="{Binding Loc[Profiles_Modal_Subtitle]}" FontSize="11" Foreground="{DynamicResource AppTextMuted}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding CloseProfilesModalCommand}" Content="✕" Background="Transparent" Foreground="{DynamicResource AppTextMuted}" FontSize="12" Padding="4,2" />
                        </Grid>

                        <!-- Content Area -->
                        <Grid Grid.Row="1" RowDefinitions="*, Auto">
                            <!-- Profiles List View (when not editing) -->
                            <Border Grid.Row="0" Classes="modalSection" Margin="0,0,0,8" Padding="6" IsVisible="{Binding !IsEditingProfile}">
                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="4">
                                        <ItemsControl ItemsSource="{Binding Profiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:TerminalProfileItemViewModel">
                                                    <Border Background="{DynamicResource AppSurfaceBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,2">
                                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                                            <Border Grid.Column="0" Background="{DynamicResource AppSurfaceSubtle}" CornerRadius="3" Padding="4,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding IconTag}" FontFamily="Consolas, monospace" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppAccent}" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppTextPrimary}" />
                                                                    <TextBlock Text="✓" Foreground="{DynamicResource AppSuccess}" FontSize="10" IsVisible="{Binding IsAvailable}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding ExecutablePath}" FontSize="10" Foreground="{DynamicResource AppTextMuted}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                                            </StackPanel>
                                                            <Button Grid.Column="2"
                                                                    Content="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Profiles_Btn_Edit]}"
                                                                    Command="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).StartEditProfileCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="8,3"
                                                                    FontSize="11"
                                                                    Margin="4,0"
                                                                    Background="{DynamicResource AppSurfaceSubtle}"
                                                                    Foreground="{DynamicResource AppTextPrimary}"
                                                                    CornerRadius="3" />
                                                            <Button Grid.Column="3"
                                                                    Content="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Profiles_Btn_Delete]}"
                                                                    Command="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).DeleteProfileCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding !IsBuiltIn}"
                                                                    Padding="8,3"
                                                                    FontSize="11"
                                                                    Background="Transparent"
                                                                    Foreground="#F7768E"
                                                                    CornerRadius="3" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- Profile Edit / Create Form (when IsEditingProfile == true) -->
                            <Border Grid.Row="0" Classes="modalSection" Margin="0,0,0,8" Padding="10" IsVisible="{Binding IsEditingProfile}">
                                <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding Loc[Profiles_Edit_Title]}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AppAccent}" IsVisible="{Binding !IsCreatingNewProfile}" />
                                        <TextBlock Text="{Binding Loc[Profiles_Create_Title]}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AppAccent}" IsVisible="{Binding IsCreatingNewProfile}" />

                                        <!-- Name -->
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Loc[Profiles_Field_Name]}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" />
                                            <TextBox Text="{Binding EditingProfileName, Mode=TwoWay}" FontSize="12" />
                                        </StackPanel>

                                        <!-- Executable Path -->
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Loc[Profiles_Field_Path]}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" />
                                            <TextBox Text="{Binding EditingExecutablePath, Mode=TwoWay}" FontSize="12" />
                                        </StackPanel>

                                        <!-- Arguments -->
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Loc[Profiles_Field_Args]}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" />
                                            <TextBox Text="{Binding EditingArguments, Mode=TwoWay}" FontSize="12" />
                                        </StackPanel>

                                        <!-- Tag & Shell Type -->
                                        <Grid ColumnDefinitions="*, *">
                                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Loc[Profiles_Field_Icon]}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" />
                                                <TextBox Text="{Binding EditingIconTag, Mode=TwoWay}" MaxLength="6" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding Loc[Profiles_Field_ShellType]}" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" />
                                                <ComboBox SelectedIndex="{Binding EditingShellType}" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem Content="PowerShell" />
                                                    <ComboBoxItem Content="NuShell" />
                                                    <ComboBoxItem Content="WSL (Linux)" />
                                                    <ComboBoxItem Content="CMD" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Form Buttons -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                                            <Button Content="{Binding Loc[Profiles_Btn_Cancel]}" Command="{Binding CancelEditProfileCommand}" Padding="12,4" FontSize="11" Background="Transparent" Foreground="{DynamicResource AppTextMuted}" />
                                            <Button Content="{Binding Loc[Profiles_Btn_Save]}" Command="{Binding SaveProfileCommand}" Padding="16,4" FontSize="11" Background="{DynamicResource AppAccent}" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="3" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- Modal Bottom Bar Actions -->
                        <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto" Margin="0,4,0,0" IsVisible="{Binding !IsEditingProfile}">
                            <Button Grid.Column="0" Content="{Binding Loc[Profiles_Btn_Reset]}" Command="{Binding ResetProfilesToDefaultCommand}" FontSize="11" Padding="8,4" Background="Transparent" Foreground="{DynamicResource AppTextMuted}" />
                            <Button Grid.Column="2" Content="{Binding Loc[Profiles_Btn_Add]}" Command="{Binding StartNewProfileCommand}" FontSize="11" FontWeight="Bold" Padding="14,5" Background="{DynamicResource AppAccent}" Foreground="#FFFFFF" CornerRadius="4" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================== -->
            <!-- Unified Tab Switcher HUD Overlay (Ctrl+Tab & Tab Bar Button) -->
            <!-- ========================================== -->
            <Grid x:Name="TabSwitcherOverlay"
                  x:DataType="vm:MainViewModel"
                  Background="#66000000"
                  IsVisible="{Binding IsTabSwitcherOpen}"
                  ZIndex="45"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Border Width="520"
                        MaxHeight="420"
                        Background="{DynamicResource AppSurfaceModal}"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        BoxShadow="0 8 32 0 #88000000"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="16">
                    <Grid RowDefinitions="Auto, *, Auto">
                        <!-- Switcher Header -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,12">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="📑" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Loc[Tab_Switcher_Title]}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="{DynamicResource AppAccent}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TabSwitcherCountText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AppTextMuted}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                            <Button Grid.Column="2"
                                    Content="✕"
                                    Classes="tabCloseBtn"
                                    Command="{Binding CancelTabSwitcherCommand}"
                                    Width="22" Height="22"
                                    FontSize="11"
                                    Padding="0" />
                        </Grid>

                        <!-- Switcher Tab List -->
                        <Border Grid.Row="1" Classes="modalSection" Margin="0,0,0,10" Padding="4">
                            <ListBox x:Name="TabSwitcherListBox"
                                     Classes="tabSwitcherListBox"
                                     ItemsSource="{Binding Tabs}"
                                     SelectedIndex="{Binding TabSwitcherSelectedIndex, Mode=TwoWay}"
                                     MaxHeight="280">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TerminalTabViewModel">
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto"
                                              Background="Transparent">
                                            <!-- Shell Badge Icon -->
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource AppSurfaceSubtle}"
                                                    BorderBrush="{DynamicResource AppBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,3"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text=">_"
                                                           FontFamily="Consolas, monospace"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AppAccent}" />
                                            </Border>

                                            <!-- Tab Title & Directory -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource AppTextPrimary}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding WorkingDirectory}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource AppTextMuted}"
                                                           TextTrimming="PrefixCharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Active Badge Indicator -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,4,0">
                                                <TextBlock Text="●"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource AppSuccess}"
                                                           IsVisible="{Binding IsSelected}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Close Tab Button (REQ-TAB-023) -->
                                            <Button Grid.Column="3"
                                                    Classes="tabSwitcherCloseBtn"
                                                    Command="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).CloseTabFromSwitcherCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{Binding $parent[views:MainWindow].((vm:MainViewModel)DataContext).Loc[Btn_Tab_Close_Tooltip]}"
                                                    Margin="6,0,2,0">
                                                <TextBlock Text="✕"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Switcher Footer (Shortcuts / Navigation Hint) -->
                        <TextBlock Grid.Row="2"
                                   Text="{Binding TabSwitcherHintText}"
                                   FontSize="10"
                                   Foreground="{DynamicResource AppTextMuted}"
                                   HorizontalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
