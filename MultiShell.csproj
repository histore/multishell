<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\multishell.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <VersionPrefix>0.0.1</VersionPrefix>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MultiShell.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Remove="MultiShell.Tests\**" />
    <EmbeddedResource Remove="MultiShell.Tests\**" />
    <None Remove="MultiShell.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.2.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MinVer" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SvcSystems.UI.Terminal" Version="2.3.5" />
  </ItemGroup>

  <!-- Restored unconditionally so Release/Debug builds without re-restoring succeed;
       excluded from Release compilation, runtime output, and host configuration. -->
  <Target Name="ExcludeDiagnosticsSupportInNonDebug"
          AfterTargets="ResolvePackageAssets"
          Condition="'$(Configuration)' != 'Debug'">
    <ItemGroup>
      <ResolvedCompileFileDefinitions Remove="@(ResolvedCompileFileDefinitions)"
                                      Condition="'%(NuGetPackageId)' == 'AvaloniaUI.DiagnosticsSupport'" />
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)"
                             Condition="'%(NuGetPackageId)' == 'AvaloniaUI.DiagnosticsSupport'" />
      <ResolvedCopyLocalItems Remove="@(ResolvedCopyLocalItems)"
                              Condition="'%(NuGetPackageId)' == 'AvaloniaUI.DiagnosticsSupport'" />
      <RuntimeHostConfigurationOption Remove="Avalonia.Diagnostics.Diagnostic.IsEnabled" />
    </ItemGroup>
  </Target>
</Project>
